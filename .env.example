# OpenAI(모델명은 환경 변수로 정한다)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# MySQL(docker-compose.yml과 같은 값)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mpilot
MYSQL_PASSWORD=mpilot
MYSQL_DATABASE=mpilot
# CI의 real_db 테스트 전용(시연용과 분리)
MYSQL_TEST_DATABASE=mpilot_test

# 데모 로그인 계정(실제 인증이 아니다. 고객·엔지니어 ID는 서로 달라야 한다)
DEMO_CUSTOMER_ID=
DEMO_CUSTOMER_PASSWORD=
DEMO_ENGINEER_ID=
DEMO_ENGINEER_PASSWORD=

# 엔지니어 검색 근거 충분성 임계값: 0 이상의 유한한 실수여야 한다(비우거나 범위를 벗어나면 앱이 시작되지 않는다)
# 0.80은 평가(#49) 전에 정한 임시 후보다. 합본 매뉴얼 40코드를 OpenAI 임베딩으로 재, 절 접두 임베딩(c2)을 적용한 뒤
# 답할 수 있는 질의의 97%가 통과하고 무관한 질문의 59%가 보류되는 값이다. 거리 척도는 Chroma 기본(제곱 L2)이며
# 척도가 정해지면(#92) 다시 잰다. 보류를 더 엄격히 하려면 0.75를 쓴다. 평가 결과를 보고 사람이 정한다.
# (가짜 DB 수동 테스트는 이 값을 읽지 않고 `fake.run --evidence-threshold`의 기본 1.0을 쓴다.)
EVIDENCE_THRESHOLD=0.80
# 선택: MANUAL_K, HISTORY_K(기본 3), LLM_TIMEOUT_SECONDS(기본 60)

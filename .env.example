# OpenAI(모델명은 환경 변수로 정한다)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# MySQL(docker-compose.yml과 같은 값)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=mpilot
MYSQL_PASSWORD=mpilot
MYSQL_DATABASE=mpilot
# CI의 real_db 테스트 전용(시연용과 분리)
MYSQL_TEST_DATABASE=mpilot_test

# 데모 로그인 계정(실제 인증이 아니다. 고객·엔지니어 ID는 서로 달라야 한다)
DEMO_CUSTOMER_ID=
DEMO_CUSTOMER_PASSWORD=
DEMO_ENGINEER_ID=
DEMO_ENGINEER_PASSWORD=

# 엔지니어 검색 근거 충분성 임계값: 0 이상의 유한한 실수여야 한다(비우거나 범위를 벗어나면 앱이 시작되지 않는다)
# 1.0은 평가(#49) 전에 가짜 DB(fake/)의 청크로 질문 19개를 잰 거리로 정한 수동 테스트용 임시 값이다(0.5는 어떤 질문도 통과시키지 못했다).
# 가짜 DB 청크 기준이라 실제 parser와 다를 수 있다. 평가 결과를 보고 사람이 정한다.
EVIDENCE_THRESHOLD=1.0
# 선택: MANUAL_K, HISTORY_K(기본 3), LLM_TIMEOUT_SECONDS(기본 60)
